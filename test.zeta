}

sealed interface Sealed permits A, B, C {
    func method(&this);
}

impl<T> Point<T> {
    const MAX: i32 = 100;

    public func new(x: i32, y: i32, tag: T): Point<T> {
        return Point<T> { x: x, y: y, tag: tag };
    }

    func area(&this): i32 {
        let mut total: i32 = 0;
        for (let mut i: i32 = 0; i < 10; i += 1) {
            total = total + i;
        }
        return total;
    }
}

