{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zeta",
      "camelcase": "Zeta",
      "title": "Zeta",
      "scope": "source.zeta",
      "path": ".",
      "file-types": ["zeta"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.3.0-alpha",
    "license": "MIT",
    "links": {"repository": "https://github.com/zeta-lang/tree-sitter-zeta-lang" },
    "description": "Zeta grammar for tree-sitter",
    "authors": [{ "name": "Wildered" }]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
